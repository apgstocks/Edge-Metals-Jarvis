{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "1.0.0",
  "description": "Edge Metals yard assistant, on the desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "JARVIS_URL=http://localhost:8080 JARVIS_DEV=1 electron .",
    "build": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "model": "mkdir -p \"$HOME/Library/Application Support/Jarvis/models\" && curl -L -o \"$HOME/Library/Application Support/Jarvis/models/ggml-tiny.en.bin\" https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin",
    "model:base": "mkdir -p \"$HOME/Library/Application Support/Jarvis/models\" && curl -L -o \"$HOME/Library/Application Support/Jarvis/models/ggml-base.en.bin\" https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
    "start:base": "JARVIS_WHISPER_MODEL=base.en electron ."
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.edgemetals.jarvis",
    "productName": "Jarvis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "speech.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens for \"Hey Jarvis\" so you can ask about loads and payments without typing."
      }
    }
  },
  "dependencies": {
    "smart-whisper": "^0.8.1",
    "kokoro-js": "^1.2.1"
  }
}
