# Copy to keystore.properties and fill in. NEVER commit the real file or the .jks.
#
# Create the keystore once (keep the answers, you'll need them here):
#   keytool -genkey -v -keystore edge-yard-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias edge-yard
#
# Then back up BOTH edge-yard-release.jks and this file. Google Play ties this
# app listing to this key permanently — without it you can never ship an update.
storeFile=../edge-yard-release.jks
storePassword=CHANGE_ME
keyAlias=edge-yard
keyPassword=CHANGE_ME
