<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- android:resizeableActivity below is an explicit opt-in for
             tablet compatibility, per Apsara 2026-08-17 ("make the
             android app tablet friendly as well"). targetSdk 34
             (variables.gradle) already defaults this to true, but
             Android's large-screen/multi-window checks (split-screen,
             freeform on Chromebooks/foldables) specifically look for it
             declared explicitly rather than relying on the default —
             makes the intent unambiguous rather than "true because
             nothing said otherwise." There's no supports-screens tag
             anywhere in this manifest restricting which screen sizes the
             app installs on, and no orientation lock on this activity
             (see configChanges below + no android:screenOrientation), so
             tablets in either orientation were already never blocked at
             the native/install level — this was really a CSS problem
             (see mobile-app/www/index.html's breakpoint split); this
             attribute just makes the native side explicit too. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this, the WebView's "Take Photo" file-input path (the
         hidden <input type="file" capture="environment"> in index.html)
         silently fails to hand off to the camera app — it's not a JS bug,
         Android just refuses the camera intent with no permission
         declared. This worked fine when testing the same page in the
         phone's regular browser (Chrome) because Chrome already carries
         its own camera permission; this app's embedded WebView is a
         separate sandboxed context and needs its own. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Voice commands (2026-08-23). The speech-recognition plugin's own
         manifest already declares RECORD_AUDIO and the RecognitionService
         <queries> entry, and the manifest merger would pull both in on its
         own — declared here as well so the app's required permissions are
         readable in one place rather than only discoverable by opening a
         dependency's manifest. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- required="false" so the app still installs on a camera-less
         device (e.g. a tablet used only for reviewing loads) — it just
         won't be able to use the camera capture button there. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
