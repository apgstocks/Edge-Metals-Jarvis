@@ -8428,6 +8429,15 @@ const PO_LOGO = '<svg width="56" height="56" viewBox="0 0 48 48"><rect x="1.5" y
 
 // The sheet. Used for BOTH the preview and the print window, so what is on
 // screen is what comes out. Every typed value goes through esc().
+// Deliver-to is "Name\nAddress..."; show it the way Vendor is shown (bold name,
+// address under it) so the two cards read the same.
+function poShipToHtml(shipTo, miss) {
+  if (!shipTo) return '<div class="nm">' + miss('—') + '</div>';
+  const parts = String(shipTo).split('\n');
+  const rest = parts.slice(1).join('\n').trim();
+  return '<div class="nm">' + esc(parts[0]) + '</div>' + (rest ? '<div class="v">' + esc(rest) + '</div>' : '');
+}
