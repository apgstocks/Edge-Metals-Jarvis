@@ -403,6 +403,15 @@ const BOOK = [
         ck('Deliver-to has a bold name line, as Vendor does', cards()[1].querySelector('.nm') && cards()[1].querySelector('.nm').textContent === 'Edge Metals', cards()[1].innerHTML);
         ck('and the address sits under it, not in the name', /Devonshire/.test(cards()[1].querySelector('.v').textContent) && !/Devonshire/.test(cards()[1].querySelector('.nm').textContent));
         ck('Vendor still has its name and address', cards()[0].querySelector('.nm').textContent === 'FMC Metals' && /62nd/.test(cards()[0].querySelector('.v').textContent));
+        type('po_supplier_address', 'FMC Metals\n800 East 62nd Street\nLos Angeles');
+        ck('an address that starts with the vendor name does not print the name twice', (cards()[0].textContent.match(/FMC Metals/g) || []).length === 1 && /800 East 62nd/.test(cards()[0].textContent), cards()[0].textContent);
+        type('po_supplier_address', 'Unit 5\n800 East 62nd Street');
+        ck('but a different first line is kept', /Unit 5/.test(cards()[0].textContent));
+        type('po_supplier_address', 'FMC Metals');
+        ck('and an address that is only the name is not blanked out', (cards()[0].textContent.match(/FMC Metals/g) || []).length >= 1);
+        type('po_supplier_address', '800 East 62nd Street\nLos Angeles');
+        const css = w.eval('poSheetCss()');
+        ck('printed, the sheet is as tall as the page (A4 or Letter) with the signatures at the foot', /@media print\{[^}]*min-height:100vh/.test(css) && /\.sign\{margin-top:auto/.test(css), css.slice(-400));
         pick('po_deliver', '');
         ck('with no delivery chosen the card shows a dash, not a blank', cards()[1].querySelector('.nm') && /—/.test(cards()[1].textContent), cards()[1].innerHTML);
         pick('po_deliver', 'edge-metals-bofa');
