+    + (d.otherCents ? '<div><span>Freight / other</span><span>' + esc(poMoney(d.otherCents)) + '</span></div>' : '')
+    + '<div class="grand"><span>Total (USD)</span><span>' + esc(poMoney(d.totalCents)) + '</span></div></div>'
+    + (d.notes ? '<div class="notes">' + esc(d.notes) + '</div>' : '')
