+// ── Purchase order tab ────────────────────────────────────────────────────
+// Apsara, 2026-10-26: "Create a purchase order tab in documents, design it
+// properly." Self-contained on purpose — it shares only the page's own
+// helpers (esc, $, the address-book typeahead, the date picker, bankAccounts)
+// and writes nothing anywhere. Nothing outside this block calls into it
+// except setSubtab(). Decisions that were mine, not hers: there is no saved
+// record and no auto-numbering yet, and the issuing company is never
+// pre-selected.
+//
+// Line totals are held in whole cents and the quantity-times-price product is
+// rounded once per line, so the figures on paper add up exactly. The money
+// boxes are text, not type=number — see tests/money-fields.js for the day a
+// "$" in a number box deleted $205 from an invoice.
+const PO_UNITS = ['MT', 'LB', 'KG', 'Gross ton', 'PCS', 'Container'];
+let poWired = false;
+let poLineSeq = 0;
+
+// The contact line under the company name. Taken from what the Edge Metals
+// proforma header already prints (assets/proforma-dc2/template.html) — my
+// choice to reuse it here, not an instruction about the PO. Edge Trading's
+// letterhead in helpers/pdf.js carries the same phone and email.
+const PO_CONTACT = { phone: '+1 (310) 938-2525', email: 'bose@edgemetals.com' };
+const PO_DEFAULT_SIGNER = 'Chandra Bose';
+// The buyer signature image, fetched once from /api/po/signature. undefined =
+// not asked yet, null = asked and there is none (the line then prints blank).
+let poSignatureUrl;
+
+// Same loose name test the BOL uses for its shipper signature
+// (helpers/bolPdf.js isEdgeMetals): case and spacing ignored, a trailing
+// Inc / Inc. / LLC tolerated.
+function poIsEdgeMetals(name) {
+  return String(name || '').toLowerCase().replace(/[.,]/g, ' ').replace(/\s+/g, ' ').trim()
+    .replace(/\s(inc|llc)$/, '') === 'edge metals';
+}
+
+// A box's text -> a number, or null when it is empty or not a number.
+// Strips "$", commas and spaces; allows one leading minus.
+function poParseNumber(v) {
+  const s = String(v == null ? '' : v).replace(/[$,\s]/g, '');
+  if (!/^-?(\d+\.?\d*|\.\d+)$/.test(s)) return null;
+  const n = Number(s);
+  return Number.isFinite(n) ? n : null;
+}
+function poMoney(cents) {
+  const neg = cents < 0;
+  const abs = Math.abs(cents);
+  const whole = String(Math.floor(abs / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return (neg ? '-' : '') + '$' + whole + '.' + String(abs % 100).padStart(2, '0');
+}
+// A unit price keeps up to four decimals, never fewer than two.
+function poPrice(n) {
+  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
+}
+function poQty(n) {
+  return n.toLocaleString('en-US', { maximumFractionDigits: 3 });
+}
+
+function poAddLine(seed) {
+  poLineSeq += 1;
+  const n = poLineSeq;
+  const row = document.createElement('div');
+  row.className = 'po-line';
+  row.dataset.line = String(n);
+  row.innerHTML =
+    '<div class="field" style="margin-bottom:6px;"><label for="po_l' + n + '_desc">Description</label>'
+    + '<input id="po_l' + n + '_desc" data-f="desc" type="text" autocomplete="off" placeholder="e.g. Copper birch/cliff"></div>'
+    + '<div style="display:grid; grid-template-columns:1fr 92px 1fr auto; gap:8px; align-items:end;">'
+    + '<div class="field" style="margin:0;"><label for="po_l' + n + '_qty">Qty</label><input id="po_l' + n + '_qty" data-f="qty" type="text" inputmode="decimal" autocomplete="off"></div>'
+    + '<div class="field" style="margin:0;"><label for="po_l' + n + '_unit">Unit</label><select id="po_l' + n + '_unit" data-f="unit">'
+    + PO_UNITS.map((u) => '<option>' + esc(u) + '</option>').join('') + '</select></div>'
+    + '<div class="field" style="margin:0;"><label for="po_l' + n + '_price">Unit price</label><input id="po_l' + n + '_price" data-f="price" type="text" inputmode="decimal" autocomplete="off" placeholder="0.00"></div>'
+    + '<button type="button" data-f="remove" class="btn btn-secondary" title="Remove this item" aria-label="Remove this item" style="padding:7px 10px; font-size:12px;">&times;</button>'
+    + '</div>'
+    + '<div data-f="amount" class="po-line-amount"></div>';
+  if (seed) {
+    row.querySelector('[data-f="desc"]').value = seed.desc || '';
+    row.querySelector('[data-f="qty"]').value = seed.qty || '';
+    row.querySelector('[data-f="price"]').value = seed.price || '';
+  }
+  $('poLines').appendChild(row);
+  return row;
+}
+
+// Everything on the form, as plain numbers and strings. Lines with nothing
+// typed in them are skipped; a line with SOME of the three fields is kept and
+// marked bad so the problem list can name it instead of dropping it silently.
+function poCollect() {
+  const co = (typeof bankAccounts !== 'undefined' && Array.isArray(bankAccounts) ? bankAccounts : [])
+    .find((a) => a.id === $('po_company').value) || null;
+  const lines = [];
+  document.querySelectorAll('#poLines .po-line').forEach((row, i) => {
+    const get = (f) => row.querySelector('[data-f="' + f + '"]');
+    const desc = get('desc').value.trim();
+    const qtyText = get('qty').value.trim();
+    const priceText = get('price').value.trim();
+    if (!desc && !qtyText && !priceText) return;
+    const qty = poParseNumber(qtyText);
+    const price = poParseNumber(priceText);
+    const ok = !!desc && qty !== null && qty > 0 && price !== null && price >= 0;
+    lines.push({
+      n: i + 1, row, desc, qty, unit: get('unit').value, price: price === null ? 0 : price, ok,
+      // The UNIT price keeps its fractions (scrap is quoted to four places, a
+      // dollar-and-a-bit per pound); only the LINE total is rounded to a cent.
+      // toPrecision first so 1.005*100 does not land on 100.49999999999999.
+      amountCents: ok ? Math.round(Number((qty * price * 100).toPrecision(12))) : 0,
+    });
+  });
+  const otherText = $('po_other').value.trim();
+  const other = otherText ? poParseNumber(otherText) : 0;
+  const subtotalCents = lines.reduce((s, l) => s + l.amountCents, 0);
+  const otherCents = other === null ? 0 : Math.round(other * 100);
+  return {
+    company: co ? co.company : '', companyAddress: co ? (co.address || '') : '',
+    companyId: co ? co.id : '',
+    supplier: $('po_supplier').value.trim(), supplierAddress: $('po_supplier_address').value.trim(),
+    number: $('po_number').value.trim(), date: $('po_date').value.trim(), required: $('po_required').value.trim(),
+    terms: $('po_terms').value.trim(), shipTo: $('po_shipto').value.trim(),
+    lines, otherText, otherBad: other === null, otherCents,
+    notes: $('po_notes').value.trim(), signer: $('po_signer').value.trim(),
+    // His signature goes under his name, for the company he signs for, and
+    // nowhere else: another company, or another name typed in the box, prints
+    // a blank line (the BOL's rule for its shipper signature).
+    signatureImg: (poSignatureUrl && poIsEdgeMetals(co ? co.company : '')
+      && /chandra\s+bose/i.test($('po_signer').value)) ? poSignatureUrl : '',
+    subtotalCents, totalCents: subtotalCents + otherCents,
+  };
+}
+
+// What stops a PO being printed. Each entry is a sentence a person can act on.
+function poProblems(d) {
+  const p = [];
+  if (!d.company) p.push('Choose which company is issuing this order.');
+  else if (!d.companyAddress) p.push(d.company + ' has no address on the Bank tab, so the sheet would print without one.');
+  if (!d.supplier) p.push('Enter the supplier.');
+  if (!d.number) p.push('Enter a PO number.');
+  if (!d.date) p.push('Enter the PO date.');
+  else if (!toIsoDate(d.date)) p.push('The PO date is not a real date (use MM/DD/YYYY).');
+  if (d.required && !toIsoDate(d.required)) p.push('"Required by" is not a real date (use MM/DD/YYYY).');
+  if (d.otherBad) p.push('Freight / other charges is not a number.');
+  if (!d.lines.length) p.push('Add at least one item.');
+  d.lines.filter((l) => !l.ok).forEach((l) => p.push('Item ' + l.n + ' needs a description, a quantity above zero and a unit price.'));
+  if (d.totalCents < 0) p.push('The total is below zero.');
+  return p;
+}
