+    + '</div>';
+}
+
+function poRefresh() {
+  const d = poCollect();
+  $('poPreview').innerHTML = '<style>' + poSheetCss() + '</style>' + poSheetHtml(d);
+  d.lines.forEach((l) => {
+    const el = l.row.querySelector('[data-f="amount"]');
+    el.textContent = l.ok ? 'Line total ' + poMoney(l.amountCents) : '';
+  });
+  // The warning list is only shown once she has tried to print, so an empty
+  // form is not shouting at her; after that it follows her edits.
+  if (!$('poProblems').classList.contains('hidden')) poShowProblems(d);
+}
+function poShowProblems(d) {
+  const p = poProblems(d || poCollect());
+  const box = $('poProblems');
+  if (!p.length) { box.classList.add('hidden'); box.innerHTML = ''; return false; }
+  box.innerHTML = p.map((t) => '&bull; ' + esc(t)).join('<br>');
+  box.classList.remove('hidden');
+  return true;
+}
+
+function poPrint() {
+  const d = poCollect();
+  if (poShowProblems(d)) return;
+  const w = window.open('', '_blank', 'width=900,height=1100');
+  if (!w) { $('poProblems').textContent = 'The browser blocked the print window. Allow pop-ups for this site and try again.'; $('poProblems').classList.remove('hidden'); return; }
+  w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>PO ' + esc(d.number) + ' - ' + esc(d.company) + '</title>'
+    + '<style>body{margin:28px; background:#fff;} @page{margin:14mm;}' + poSheetCss() + '</style></head><body>' + poSheetHtml(d) + '</body></html>');
+  w.document.close();
+  w.focus();
+  setTimeout(() => { try { w.print(); } catch (e) { /* the sheet is open; she can print it by hand */ } }, 250);
+}
+
+function poClear() {
+  ['po_supplier', 'po_supplier_address', 'po_number', 'po_required', 'po_terms', 'po_shipto', 'po_other', 'po_notes']
+    .forEach((id) => { $(id).value = ''; });
+  $('po_company').value = '';
+  $('po_signer').value = PO_DEFAULT_SIGNER;
+  $('po_date').value = toUsDate(new Date());
+  $('poLines').innerHTML = '';
+  poAddLine();
+  $('poProblems').classList.add('hidden');
+  poRefresh();
+}
+
+function poRenderSupplierList(matches) {
+  const box = $('poSupplierList');
+  if (!matches.length) { box.classList.add('hidden'); box.innerHTML = ''; return; }
+  const shown = matches.slice(0, 8);
+  box.innerHTML = shown.map((m, i) => '<div class="autocomplete-item" data-idx="' + i + '">' + esc(addressBookEntryLabel(m)) + '</div>').join('');
+  box.classList.remove('hidden');
+  // mousedown + preventDefault and index-not-id, for the same two reasons
+  // given at renderConsigneeList: the input must not blur first, and many
+  // address-book entries have no id.
+  box.querySelectorAll('.autocomplete-item').forEach((el) => el.addEventListener('mousedown', (e) => {
+    e.preventDefault();
+    const entry = shown[Number(el.dataset.idx)];
+    if (!entry) return;
+    $('po_supplier').value = consigneeNameForEntry(entry);
+    $('po_supplier_address').value = entry.raw || '';
+    box.classList.add('hidden');
+    poRefresh();
+  }));
+}
+
+async function poLoadCompanies() {
+  const sel = $('po_company');
+  const keep = sel.value;
+  try {
+    if (!Array.isArray(bankAccounts)) {
+      const r = await fetch('/api/bank-accounts');
+      const j = await r.json();
+      if (!r.ok) throw new Error(j.error || 'could not read the companies');
+      bankAccounts = j.accounts || [];
+    }
+    sel.innerHTML = '<option value="">Select the company…</option>'
+      + bankAccounts.map((a) => '<option value="' + esc(a.id) + '">' + esc(a.company) + '</option>').join('');
+    sel.value = keep;
+  } catch (e) {
+    $('poProblems').textContent = 'Could not load the issuing companies: ' + e.message;
+    $('poProblems').classList.remove('hidden');
+  }
+}
+
+async function poLoadSignature() {
+  if (poSignatureUrl !== undefined) return;
+  try {
+    const r = await fetch('/api/po/signature');
+    const j = await r.json();
+    poSignatureUrl = (r.ok && j && typeof j.signature === 'string' && /^data:image\/png;base64,/.test(j.signature)) ? j.signature : null;
+  } catch (e) { poSignatureUrl = null; }
+  poRefresh();
+}
+
+function poInit() {
+  if (!poWired) {
+    poWired = true;
+    wireUsDateField('po_date');
+    wireUsDateField('po_required');
+    poAddLine();
+    $('po_date').value = toUsDate(new Date());
+    $('poForm').addEventListener('input', poRefresh);
+    $('poForm').addEventListener('change', poRefresh);
+    $('poAddLine').addEventListener('click', () => { poAddLine(); poRefresh(); });
+    $('poLines').addEventListener('click', (e) => {
+      const b = e.target.closest('[data-f="remove"]');
+      if (!b) return;
+      const rows = document.querySelectorAll('#poLines .po-line');
+      // Never leave the form with no item row to type into.
+      if (rows.length <= 1) { const r = b.closest('.po-line'); r.querySelectorAll('input').forEach((i) => { i.value = ''; }); }
+      else b.closest('.po-line').remove();
+      poRefresh();
+    });
+    $('po_supplier').addEventListener('input', () => {
+      const q = $('po_supplier').value.trim().toLowerCase();
+      if (!q) { $('poSupplierList').classList.add('hidden'); return; }
+      poRenderSupplierList(searchAddressBook(q));
+    });
+    $('po_supplier').addEventListener('blur', () => setTimeout(() => $('poSupplierList').classList.add('hidden'), 150));
+    $('poPrint').addEventListener('click', poPrint);
+    $('poClear').addEventListener('click', poClear);
+  }
+  poLoadCompanies();
+  poLoadSignature();
+  poRefresh();
+}
