node_modules/
.env
# ANCHORED (2026-09-23). This was `data/`, which git matches at ANY depth — so
# helpers/data/ (the ledger question engine) was silently ignored, `git add`
# said nothing, and workflow/brain.js shipped calling files that were not in
# the repo. The runtime store this line is for is the one at the ROOT.
/data/
bookings.json
# The QuickBooks digest's overnight stash (helpers/qbDigest.js). A DATA file,
# like bookings.json above — it was committed once by accident, and a tracked
# data file means `git pull` on the VM overwrites whatever the live run had
# collected that night.
qb_digest.json
*.log
.DS_Store
.wwebjs_cache/

# Built APKs and Play bundles — multi-MB binaries, rebuilt from source, do
# not belong in git. The .aab was missing here and a 4.5MB bundle very nearly
# went in with the v1.1 build.
*.apk
*.aab
